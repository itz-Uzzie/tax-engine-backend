{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "strict": true,

    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
